<ui:FancyWindow xmlns="https://spacestation14.io"
                xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls"
                Title="{Loc 'ahelp-history-window-title-loading'}"
                MinSize="500 300"
                SetSize="800 600">
    <BoxContainer Orientation="Vertical" Margin="4">
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
            <LineEdit Name="FilterLineEdit" PlaceHolder="{Loc 'ahelp-history-filter-placeholder'}" HorizontalExpand="True" />
            <Control MinSize="5 0" />
            <Label Name="CountLabel" VerticalAlignment="Center" />
        </BoxContainer>
        <PanelContainer StyleClasses="BackgroundDark" VerticalExpand="True" HorizontalExpand="True">
            <ScrollContainer Name="Scroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" Margin="4">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                    <BoxContainer Name="DialogsContainer" Orientation="Vertical" HorizontalExpand="True" />
                    <Label Name="EmptyLabel" Text="{Loc 'ahelp-history-empty'}" Visible="False" />
                    <Button Name="LoadMoreButton" Text="{Loc 'ahelp-history-load-older'}" HorizontalAlignment="Center" Margin="0 8" Visible="False" />
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</ui:FancyWindow>
