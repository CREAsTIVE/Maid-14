<DefaultWindow xmlns="https://spacestation14.io"
            Title="{Loc 'extraction-pod-ui-title'}"
            MinSize="220 280"
            SetSize="220 280">
    <PanelContainer StyleClasses="MaidTexturedBackground"
                    HorizontalExpand="True"
                    VerticalExpand="True"
                    Margin="4">
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      Margin="6">
            <!-- status and entered code -->
            <PanelContainer StyleClasses="MaidTransparentBackground" HorizontalExpand="True" Margin="0 0 0 6">
                <BoxContainer Orientation="Vertical" Margin="8 6">
                    <Label Name="StatusLabel"/>
                    <Label Name="CodeLabel"/>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer StyleClasses="MaidTransparentBackground" HorizontalExpand="True" VerticalExpand="True">
                <GridContainer Columns="3"
                               Name="KeypadGrid"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="6">
                    <!-- Keypad is filled by code -->
                </GridContainer>
            </PanelContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
