<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               Title="{Loc 'extraction-device-ui-title'}"
               MinSize="420 380"
               SetSize="420 420">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="4">
        <PanelContainer Margin="0 0 0 6">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#0d0d0d" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6">
                <RichTextLabel Name="StatusLabel" />
                <Label Name="ProgressLabel" />
            </BoxContainer>
        </PanelContainer>
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False" Margin="0 0 0 6">
            <BoxContainer Name="ObjectivesList" Orientation="Vertical" />
        </ScrollContainer>
        <Label Name="ZoneLabel" />
        <Label Name="PodLabel" />
        <Label Name="RerollsLabel" />
        <Label Name="CodeLabel" Margin="0 0 0 6" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Button Name="RefreshButton" Access="Public" Text="{Loc 'extraction-device-ui-refresh'}" HorizontalExpand="True" />
            <Button Name="ZoneButton" Access="Public" Text="{Loc 'extraction-device-ui-zone'}" HorizontalExpand="True" />
            <Button Name="PodButton" Access="Public" Text="{Loc 'extraction-device-ui-pod'}" HorizontalExpand="True" StyleClasses="Caution" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
