<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'atm-ui-title'}"
                      SetSize="400 220"
                      Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True">
        <Label Name="BalanceLabel" Visible="False"/>
        <controls:HighDivider Name="Divider" Visible="False"/>
        <Label Name="StatusLabel"/>
        <SliderIntInput Name="WithdrawSlider" Visible="False"/>
        <BoxContainer Orientation="Horizontal" VerticalExpand="True" VerticalAlignment="Bottom">
            <LineEdit Name="PinLineEdit" HorizontalExpand="True" PlaceHolder="{Loc 'atm-ui-enter-pin'}" Visible="False"/>
            <Button Name="WithdrawButton" Text="{Loc 'atm-ui-withdraw'}" Visible="False" Disabled="True"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
