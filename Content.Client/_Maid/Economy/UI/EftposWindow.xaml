<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'eftpos-ui-title'}"
                      Resizable="False"
                      SetSize="380 120">
    <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Label Text="{Loc 'eftpos-ui-amount-text'}" Margin="0 0 4 0"/>
            <LineEdit Name="AmountLineEdit" PlaceHolder="0" MinWidth="60"/>
            <Button Name="CardButton"
                    HorizontalExpand="True"
                    HorizontalAlignment="Right"
                    ToolTip="{Loc 'eftpos-ui-card-lock-desc'}"
                    Text="{Loc 'eftpos-ui-card-lock-text'}"/>
        </BoxContainer>
        <Label Name="AccountLabel" VerticalExpand="True" VerticalAlignment="Bottom"/>
    </BoxContainer>
</controls:FancyWindow>
